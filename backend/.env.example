# =============================================================
# .env.example — .env에 들어가야 하는 값 목록 (실제 값은 비워둔 견본)
# 이 파일은 Git에 올려도 되고, 실제 값이 든 .env는 절대 올리면 안 됨!
# =============================================================

# ----- DB (기존) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thinking
DB_USER=postgres
DB_PASSWORD=

# ----- 로그인 토큰 -----
# 만드는 법: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ----- 인증 메일 (비워두면 개발 모드: 인증번호가 터미널에 출력됨) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
