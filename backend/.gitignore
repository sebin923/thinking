# =============================================================
# backend/.gitignore — Git에 올리지 않을 파일/폴더 목록
# =============================================================

# ★ 비밀 정보: DB 비밀번호, JWT 키, Gmail 앱 비밀번호가 들어 있음 → 절대 올리면 안 됨
.env
.env.*
# 단, 값이 비어 있는 견본 파일은 팀원과 공유하려고 올림 (! = 예외)
!.env.example

# 파이썬 가상환경 (각자 python -m venv venv 로 만들고 pip install -r requirements.txt)
venv/
.venv/

# 파이썬이 자동으로 만드는 캐시
__pycache__/
*.pyc

# 테스트용 로컬 DB 파일
*.db

# 편집기 설정
.idea/
.vscode/
