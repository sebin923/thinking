# Adjust the root and server_name. On an existing HTTPS site, retain its TLS
# configuration and use the locations below inside that server block.
server {
    listen 80;
    server_name YOUR_DOMAIN;
    root /opt/thinking/frontend/dist;
    index index.html;
    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        # Structured AI tasks can perform one validated regeneration.
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
