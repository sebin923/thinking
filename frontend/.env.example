# =============================================================
# .env.example — 프론트엔드 환경변수 예시 (이 파일은 Git에 올라감)
# -------------------------------------------------------------
# 쓰는 법: 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우기
#   (.env는 .gitignore에 들어 있어서 Git에 안 올라감)
# 값을 바꾼 뒤에는 npm run dev를 껐다 켜야 반영됨
# =============================================================

# 백엔드 주소 (비워 두면 http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# 토스페이먼츠 클라이언트 키 (개발자센터 → API 키 메뉴, 테스트 키는 test_ck_ 로 시작)
# ★ 시크릿 키(test_sk_ / live_sk_)는 절대 여기에 넣지 말 것 → 백엔드 .env에만
VITE_TOSS_CLIENT_KEY=
